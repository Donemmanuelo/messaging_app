{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT c.id, c.name, c.is_group, c.created_at, c.updated_at\n        FROM chats c\n        JOIN chat_participants cp ON cp.chat_id = c.id\n        WHERE cp.user_id = $1 AND c.is_group = true\n        ORDER BY c.updated_at DESC\n        ",
